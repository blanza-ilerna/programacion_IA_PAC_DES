    {
      "id": 5,
      "type": "stat",
      "title": "Último dato hace",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"sensores\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"machine_stats\")\n  |> filter(fn: (r) => r._field == \"avg_temp_c\")\n  |> group()\n  |> last()\n  |> map(fn: (r) => ({r with _value: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0}))\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "sin datos 1 h",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 180
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "description": "Segundos desde la última ventana escrita por Flink. El punto lleva el inicio de la ventana, así que en funcionamiento normal ronda 60-130 s. Por encima de 300 s el pipeline (simulador, bridge o Flink) está parado."
